          "name": "PUT actualizar inexistente (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 404 Not Found', () => pm.response.to.have.status(404));",
                  "const body = pm.response.json();",
                  "pm.test('Indica que no existe el producto', () => {",
                  "    pm.expect(body.error.mensaje).to.include('no existe');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Fantasma\",\n  \"precio\": 9.9,\n  \"categoria\": \"Varios\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/productos/9999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "productos", "9999"]
            }
          },
          "response": []
        },
        {
          "name": "DELETE eliminar producto (204)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 204 No Content', () => pm.response.to.have.status(204));",
                  "pm.test('El cuerpo está vacío', () => {",
                  "    pm.expect(pm.response.text()).to.be.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/productos/{{ultimoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "productos", "{{ultimoId}}"]
            }
          },
          "response": []
        },
        {
          "name": "DELETE eliminar de nuevo (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 404 Not Found', () => pm.response.to.have.status(404));",
                  "const body = pm.response.json();",
                  "pm.test('Ya no existe el producto', () => {",
                  "    pm.expect(body.error.mensaje).to.include('no existe');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/productos/{{ultimoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "productos", "{{ultimoId}}"]
            }
          },
          "response": []
