        {
          "name": "DELETE sin token (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401 Unauthorized', () => pm.response.to.have.status(401));",
                  "const body = pm.response.json();",
                  "pm.test('Avisa que falta el token', () => {",
                  "    pm.expect(body.error.mensaje).to.include('Token');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
