{
  "info": {
    "_postman_id": "a1b2c3d4-0000-4000-8000-000000000001",
    "name": "API Catálogo de Productos - Módulo 3",
    "description": "Colección de pruebas para la API REST del catálogo de productos.\n\n1. Ejecuta primero 'Login' para obtener el token (se guarda automáticamente en la variable {{token}}).\n2. Luego ejecuta las peticiones de las carpetas siguientes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Login - credenciales correctas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('La respuesta tiene ok=true', () => pm.expect(body.ok).to.eql(true));",
                  "pm.test('Devuelve un token JWT', () => {",
                  "    pm.expect(body.data).to.have.property('token');",
                  "    pm.expect(body.data.token.split('.').length).to.eql(3); // formato JWT",
                  "});",
                  "",
                  "// Guarda el token para las demás peticiones",
                  "pm.collectionVariables.set('token', body.data.token);",
                  "pm.test('Token guardado en variable de colección', () => {",
                  "    pm.expect(pm.collectionVariables.get('token')).to.not.be.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Pública. Devuelve el token JWT que usan las rutas protegidas."
          },
          "response": []
        },
        {
          "name": "Login - credenciales inválidas (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401 Unauthorized', () => pm.response.to.have.status(401));",
                  "const body = pm.response.json();",
                  "pm.test('Mensaje de credenciales inválidas', () => {",
                  "    pm.expect(body.error.mensaje).to.eql('Credenciales inválidas');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"admin\",\n  \"password\": \"contraseña-incorrecta\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Productos - Consultas públicas",
      "item": [
        {
          "name": "GET listar todos (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Devuelve un arreglo de productos', () => {",
                  "    pm.expect(body.data).to.be.an('array');",
                  "    pm.expect(body.total).to.eql(body.data.length);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/productos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "productos"]
            }
          },
          "response": []
        },
        {
          "name": "GET listar con filtros ?categoria=&buscar= (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Todos los resultados son de la categoría filtrada', () => {",
                  "    body.data.forEach((p) => {",
                  "        pm.expect(p.categoria.toLowerCase()).to.eql('perifericos');",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/productos?categoria=Perifericos&buscar=mouse",
              "host": ["{{baseUrl}}"],
              "path": ["api", "productos"],
              "query": [
                { "key": "categoria", "value": "Perifericos" },
                { "key": "buscar", "value": "mouse" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "GET detalle por id (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('El producto tiene id, nombre y precio', () => {",
                  "    pm.expect(body.data).to.have.property('id');",
                  "    pm.expect(body.data).to.have.property('nombre');",
                  "    pm.expect(body.data).to.have.property('precio');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/productos/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "productos", "1"]
            }
          },
          "response": []
        },
        {
          "name": "GET detalle inexistente (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 404 Not Found', () => pm.response.to.have.status(404));",
                  "const body = pm.response.json();",
                  "pm.test('Mensaje indica que no existe', () => {",
                  "    pm.expect(body.ok).to.eql(false);",
                  "    pm.expect(body.error.mensaje).to.include('no existe');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/productos/9999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "productos", "9999"]
            }
          },
          "response": []
        },
        {
          "name": "GET id inválido (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400 Bad Request', () => pm.response.to.have.status(400));",
                  "const body = pm.response.json();",
                  "pm.test('Reporta errores de validación', () => {",
                  "    pm.expect(body.error.mensaje).to.eql('Errores de validación');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/productos/abc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "productos", "abc"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Productos - Operaciones protegidas (JWT)",
      "item": [
        {
          "name": "POST crear producto (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('El producto se creó con id y timestamps', () => {",
                  "    pm.expect(body.data).to.have.property('id');",
                  "    pm.expect(body.data).to.have.property('createdAt');",
                  "    pm.expect(body.data.nombre).to.eql('Webcam Full HD');",
                  "});",
                  "// Guarda el id para las siguientes pruebas",
                  "pm.collectionVariables.set('ultimoId', String(body.data.id));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Webcam Full HD\",\n  \"precio\": 39.9,\n  \"categoria\": \"Perifericos\",\n  \"descripcion\": \"Camara 1080p con microfono integrado.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/productos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "productos"]
            }
          },
          "response": []
        },
        {
          "name": "POST crear sin token (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401 Unauthorized', () => pm.response.to.have.status(401));",
                  "const body = pm.response.json();",
                  "pm.test('Avisa que falta el token', () => {",
                  "    pm.expect(body.error.mensaje).to.include('Token no proporcionado');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Sin token\",\n  \"precio\": 1,\n  \"categoria\": \"Varios\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/productos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "productos"]
            }
          },
          "response": []
        },
        {
          "name": "POST crear con datos inválidos (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400 Bad Request', () => pm.response.to.have.status(400));",
                  "const body = pm.response.json();",
                  "pm.test('Lista los campos con error', () => {",
                  "    pm.expect(body.error.detalles.length).to.be.above(0);",
                  "    const campos = body.error.detalles.map((d) => d.campo);",
                  "    pm.expect(campos).to.include('precio');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"\",\n  \"precio\": -5,\n  \"categoria\": \"\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/productos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "productos"]
            }
          },
          "response": []
        },
        {
          "name": "POST crear duplicado (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 409 Conflict', () => pm.response.to.have.status(409));",
                  "const body = pm.response.json();",
                  "pm.test('Avisa el nombre duplicado', () => {",
                  "    pm.expect(body.error.mensaje).to.include('Ya existe');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Mouse Inalambrico MX\",\n  \"precio\": 10,\n  \"categoria\": \"Perifericos\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/productos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "productos"]
            }
          },
          "response": []
        },
        {
          "name": "PUT actualizar producto (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('El precio fue actualizado', () => {",
                  "    pm.expect(body.data.precio).to.eql(45.5);",
                  "    pm.expect(body.data).to.have.property('updatedAt');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Webcam Full HD\",\n  \"precio\": 45.5,\n  \"categoria\": \"Perifericos\",\n  \"descripcion\": \"Camara 1080p con enfoque automatico.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/productos/{{ultimoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "productos", "{{ultimoId}}"]
            }
          },
          "response": []
        },
